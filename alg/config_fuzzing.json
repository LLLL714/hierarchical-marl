                "importance_weight": 0.7,
                "mutation_priority": "medium"
            },
            {
                "name": "flags",
                "type": "bitfield",
                "num_bits": 8,
                "importance_weight": 0.6,
                "mutation_priority": "low"
            },
            {
                "name": "checksum",
                "type": "integer",
                "min_value": 0,
                "max_value": 4294967295,
                "importance_weight": 0.5,
                "mutation_priority": "low"
            },
            {
                "name": "sequence_number",
                "type": "integer",
                "min_value": 0,
                "max_value": 4294967295,
                "importance_weight": 0.4,
                "mutation_priority": "low"
            },
            {
                "name": "options",
                "type": "bytes",
                "min_length": 0,
                "max_length": 40,
                "importance_weight": 0.3,
                "mutation_priority": "low"
            }
        ],
        "mutation_actions": [
            {
                "name": "insert",
                "description": "Insert random bytes into field",
                "complexity": "low",
                "effectiveness": 0.7
            },
            {
                "name": "delete", 
                "description": "Remove bytes from field",
                "complexity": "low",
                "effectiveness": 0.6
            },
            {
                "name": "flip",
                "description": "Flip random bits in field",
                "complexity": "medium",
                "effectiveness": 0.8
            },
            {
                "name": "replace",
                "description": "Replace field with random data",
                "complexity": "medium", 
                "effectiveness": 0.9
            },
            {
                "name": "shuffle",
                "description": "Randomly reorder bytes in field",
                "complexity": "medium",
                "effectiveness": 0.5
            },
            {
                "name": "copy",
                "description": "Duplicate field content",
                "complexity": "low",
                "effectiveness": 0.4
            }
        ],
        "mamba_feature_dim": 256,
        "mutation_context_dim": 16,
